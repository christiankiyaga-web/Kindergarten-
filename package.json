{
  "name": "samlax-kindergarten",
  "productName": "Samlax Kindergarten",
  "version": "1.0.0",
  "description": "Samlax Kindergarten school management system",
  "author": "Samlax Kindergarten",
  "main": "main.js",
  "scripts": {
    "prep": "node prep.js",
    "start": "node prep.js && electron .",
    "build": "node prep.js && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "ug.samlax.school",
    "productName": "Samlax Kindergarten",
    "files": ["main.js", "index.html"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
